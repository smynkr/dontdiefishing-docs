{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Axiomancer Labs",
  "description": "DontDieFishing documentation \u2014 safe fishing spots with real-time water conditions, weather, and hazard data.",
  "colors": {
    "primary": "#00D4FF",
    "light": "#5DE5FF",
    "dark": "#0099BF"
  },
  "favicon": "/images/favicon.svg",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://axiomancer.io"
  },
  "navigation": {
    "products": [
      {
        "product": "DontDieFishing",
        "description": "Find safe fishing spots with real-time water conditions, weather, and hazard data.",
        "icon": "life-buoy",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get started",
                "icon": "rocket",
                "pages": [
                  "dontdiefishing/index",
                  "dontdiefishing/getting-started"
                ]
              },
              {
                "group": "Product",
                "icon": "map-pin",
                "pages": [
                  "dontdiefishing/finding-spots",
                  "dontdiefishing/safety-conditions"
                ]
              },
              {
                "group": "Support",
                "icon": "circle-help",
                "pages": [
                  "dontdiefishing/faq",
                  "dontdiefishing/changelog"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "navbar": {
    "links": [
      {
        "label": "DontDieFishing",
        "href": "https://dontdiefishing.com"
      }
    ],
    "primary": {
      "type": "button",
